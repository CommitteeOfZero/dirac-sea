<Installer>
    <Name>Impacto</Name>
    <Version>1.0.0</Version>
    <Title>Impacto Installer</Title>
    <Publisher>Committee of Zero</Publisher>
    <StartMenuDir>Committee of Zero</StartMenuDir>
    <TargetDir>@ApplicationsDir@/Committee of Zero/Impacto</TargetDir>
    <RemoteRepositories>
        <Repository>
            <Url>https://sonome.dareno.me/dirac-sea/</Url>
            <Enabled>1</Enabled>
        </Repository>
    </RemoteRepositories>
    <MaintenanceToolName>Updater</MaintenanceToolName>
    <ControlScript>controller.qs</ControlScript>
    <WizardStyle>Classic</WizardStyle>
    <WizardDefaultWidth>800</WizardDefaultWidth>
    <WizardDefaultHeight>600</WizardDefaultHeight>
</Installer>